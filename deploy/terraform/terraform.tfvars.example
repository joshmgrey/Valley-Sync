# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# --- Region -----------------------------------------------------------------
# Must match the region hardcoded in versions.tf backend.
aws_region = "us-east-1"

# --- DNS / TLS -------------------------------------------------------------
# You must already own this domain and have a PUBLIC Route53 hosted zone for it.
# The app will be served at https://<subdomain>.<domain_name>.
domain_name = "example.com"
subdomain   = "app"

# --- Secrets --------------------------------------------------------------
# AUTH_SECRET: generate with `openssl rand -base64 32`
auth_secret = "REPLACE_ME_base64_32_bytes"

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL MUST be:
#   https://<subdomain>.<domain_name>/api/auth/callback/github
auth_github_id     = "REPLACE_ME"
auth_github_secret = "REPLACE_ME"

# --- Optional overrides (defaults are fine for a first deploy) --------------
# container_cpu          = 512
# container_memory       = 1024
# db_instance_class      = "db.t4g.micro"
# db_deletion_protection = true
# image_tag              = "bootstrap"   # CI sets this to the git SHA
