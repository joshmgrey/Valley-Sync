DATABASE_URL="postgresql://valley:valley@localhost:5432/valley_sync"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Auth.js — generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Production only (set by Terraform via SSM, not needed for local dev):
#   AUTH_URL         — https://<subdomain>.<domain>, the OAuth callback base
#   AUTH_TRUST_HOST  — "true", so Auth.js trusts the ALB's X-Forwarded-* headers
